<span class="loading-indicator @(Decorative ? "loading-indicator-decoration" : "")" role="@(Decorative ? null : "status")" aria-hidden="@(Decorative ? "true" : null)">
    <span class="loading-spinner" aria-hidden="true"></span>
    @if (!Decorative) { <span>@Label</span> }
</span>

@code {
    [Parameter] public string Label { get; set; } = "Loading…";
    [Parameter] public bool Decorative { get; set; }
}
