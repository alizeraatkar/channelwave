@using System.Globalization

<div class="music-seekbar @(Compact ? "music-seekbar-compact" : "") @(IsPlaying && !IsPreparing && !Disabled ? "is-playing" : "") @(Disabled ? "is-disabled" : "")" style="@($"--played:{Number(Fraction(displayPosition))}%;--buffered:{Number(Fraction(Buffered))}%")">
    <div class="music-seek-control">
        <div class="music-seek-track" aria-hidden="true">
            <div class="music-seek-remaining"></div>
            <div class="music-seek-buffer"></div>
            <div class="music-seek-played">
                <svg class="music-seek-wave" width="100%" height="16" aria-hidden="true"><defs><pattern id="@patternId" width="24" height="16" patternUnits="userSpaceOnUse"><path d="M0 8 Q6 0 12 8 T24 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></pattern></defs><rect x="-24" width="calc(100% + 48px)" height="16" fill="@($"url(#{patternId})")" /></svg>
            </div>
        </div>
        <input type="range" aria-label="Playback position" aria-valuetext="@($"{Time(displayPosition)} of {Time(SafeDuration)}")" min="0" max="@Number(Math.Max(1, SafeDuration))" step="0.1" value="@Number(displayPosition)" disabled="@(Disabled || IsPreparing || SafeDuration <= 0)" @oninput="Preview" @onchange="CommitAsync" @onpointercancel="CancelPreview" @onblur="CancelPreview" />
    </div>
    <div class="music-seek-times"><span>@Time(displayPosition)</span><span>@Time(SafeDuration)</span></div>
</div>

@code {
    [Parameter] public double Position { get; set; }
    [Parameter] public double Duration { get; set; }
    [Parameter] public double Buffered { get; set; }
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public bool IsPreparing { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? MediaKey { get; set; }
    [Parameter] public EventCallback<double> OnSeek { get; set; }
    private readonly string patternId = $"seek-{Guid.NewGuid():N}";
    private double? proposed;
    private string? previousKey;
    private double SafeDuration => double.IsFinite(Duration) ? Math.Max(0, Duration) : 0;
    private double displayPosition => Clamp(proposed ?? Position);
    protected override void OnParametersSet()
    {
        if (previousKey != MediaKey || Disabled || IsPreparing) proposed = null;
        previousKey = MediaKey;
    }
    private double Clamp(double value) => double.IsFinite(value) ? Math.Clamp(value, 0, SafeDuration) : 0;
    private double Fraction(double value) => SafeDuration > 0 ? Clamp(value) / SafeDuration * 100 : 0;
    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private void Preview(ChangeEventArgs args) { if (double.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, out var value)) proposed = Clamp(value); }
    private async Task CommitAsync(ChangeEventArgs args)
    {
        if (Disabled || IsPreparing || SafeDuration <= 0) return;
        Preview(args);
        try { await OnSeek.InvokeAsync(displayPosition); }
        finally { proposed = null; }
    }
    private void CancelPreview() => proposed = null;
    private static string Time(double value)
    {
        var seconds = Math.Clamp(double.IsFinite(value) ? value : 0, 0, TimeSpan.MaxValue.TotalSeconds - 1);
        var time = TimeSpan.FromSeconds(seconds);
        return time.TotalHours >= 1 ? $"{(long)time.TotalHours}:{time:mm\\:ss}" : time.ToString(@"m\:ss");
    }
}
