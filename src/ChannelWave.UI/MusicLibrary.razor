    private bool buffering => Playback.IsPreparing;
    private bool savingList, playingOffline, playingOfflineOnly;
    private IReadOnlyList<Track> playingSequence = [];
    private string? playError, actionError, feedback;
    [Parameter] public EventCallback OnActivity { get; set; }
