    protected override async Task OnParametersSetAsync()
    {
        channel = SelectedSource?.ToString(CultureInfo.InvariantCulture) ?? "";
        if (!ReferenceEquals(offlineVersion, OfflineTracks))
        {
            offlineVersion = OfflineTracks;
            offlineMembership = OfflineTracks.Select(t => (t.Origin.AccountId, t.Id)).ToHashSet();
        }
        var nextView = (View, SearchMode, ShowContent);
        ResetPlaylistContext();
        if (previousView != nextView)
        {
            feedback = null;
            await DismissPreviewAsync();
            if (editor is not null) await editor.CloseAsync();
        }
        previousView = nextView;
        if (previewTrack is { } shown)
        {
            var updated = Tracks.Concat(OfflineTracks).FirstOrDefault(t => SameTrack(t, shown));
            if (updated is not null) previewTrack = updated;
        }
        if (!ShowContent && !HomeVisible && editor is not null) await editor.CloseAsync();
    }
    private string DialogContext => $"{View}:{SearchMode}:{ShowContent}";
    private Track? current => Playback.CurrentTrack;
    private TransferJob? ActiveTransfer => Transfers.Jobs.FirstOrDefault(j => j.State is TransferState.Downloading or TransferState.Saving or TransferState.Waiting or TransferState.Exporting);
    private Track? downloadingTrack => ActiveTransfer is { State: TransferState.Downloading or TransferState.Saving or TransferState.Exporting } job ? job.Track : null;
    private Track? editingTrack;
    private Track? previewTrack;
