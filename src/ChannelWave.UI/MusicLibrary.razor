    private long request;
    private readonly CancellationTokenSource lifetime = new();
    private IEnumerable<Track> Visible => Tracks;
    private bool HasActiveMedia => buffering || Playback.CanResume && audio?.Error is null;
    private double Duration => audio?.Duration is > 0 and < double.PositiveInfinity ? audio.Duration : Math.Max(0, current?.Duration ?? 0);
    private string PlaybackStatus => Playback.RestoredPaused ? "" : buffering ? playingOffline ? "Opening saved audio…" : "Connecting to Telegram. Audio will start as it buffers…"
        : playError is not null ? Playback.CanResume && audio?.Error is null ? "Ready to resume" : "Playback stopped. Retry or download this track."
        : audio?.Ended == true ? "Track finished. Choose your next listen."
        : Playback.IsPlaying ? playingOffline ? "Playing offline" : Host.CanStream ? "Streaming from Telegram" : "Playing audio" : "Paused";
    private static bool SameTrack(Track? left, Track? right) => left is not null && right is not null && left.Id == right.Id && left.Origin.AccountId == right.Origin.AccountId;
    private bool IsCurrent(Track track) => SameTrack(current, track);
    private IReadOnlyList<Track>? offlineVersion;
    private HashSet<(long Account, Guid Id)> offlineMembership = [];
    private bool IsSaved(Track track) => offlineMembership.Contains((track.Origin.AccountId, track.Id));
    private string ViewportContext => $"{BrowseContext}:{Session.AccountId}:{DialogContext}:{Playlist.Id}:{PlaylistSort}:{channel}:{Criteria}:{Display}";
    // Position and transfer bytes deliberately do not participate in this snapshot.
    private object ListVersion => (Tracks, offlineMembership, Playlist.Tracks, Busy, ShowContent, selecting,
        selectedTracks.Count, savingFavorite, savingList, savingPlaylistEdit, downloadingTrack, current,
        buffering, Playback.IsPlaying, Playback.CanResume, HasActiveMedia, playError, audio?.Ended, Criteria, PlaylistSort, Playlist.Name);
    private void OpenPreview(Track track)
    {
        previewTrack = track;
        previewSequence = Visible.ToArray();
        previewOfflineOnly = View == "offline";
        previewCollection = View switch { "favorites" => "Liked Songs", "playlist" => Playlist.Name, "offline" => "Offline", _ => SearchMode ? "Search results" : "All tracks" };
        followingPlayback = IsCurrent(track);
        feedback = actionError = null;
    }
    private void OpenCurrent()
    {
        if (current is null) return;
        previewTrack = current;
        previewSequence = playingSequence;
        previewOfflineOnly = playingOfflineOnly;
        previewCollection = "Now playing";
        followingPlayback = true;
        feedback = actionError = null;
    }
    private void ClosePreview() { previewTrack = null; fullPlayer = null; previewSequence = []; followingPlayback = false; }
    private async Task DismissPreviewAsync() { if (fullPlayer is not null) await fullPlayer.CloseAsync(); else ClosePreview(); }
    private Track? PreviewAdjacent(int delta)
    {
        if (previewTrack is null) return null;
        if (IsCurrent(previewTrack)) return Adjacent(delta);
        var index = previewSequence.ToList().FindIndex(t => SameTrack(t, previewTrack));
        return index >= 0 && index + delta >= 0 && index + delta < previewSequence.Count ? previewSequence[index + delta] : null;
    }
    private async Task SkipPreviewAsync(int delta)
    {
        if (previewTrack is null) return;
        if (IsCurrent(previewTrack)) { followingPlayback = true; await Skip(delta); }
        else if (PreviewAdjacent(delta) is { } next) { previewTrack = next; followingPlayback = IsCurrent(next); feedback = actionError = null; }
    }
    private async Task TogglePreviewAsync()
    {
        if (previewTrack is not { } track || track.Origin.Protected) return;
        if (IsCurrent(track) && (buffering || Playback.CanResume && audio?.Error is null)) { followingPlayback = true; await Toggle(); return; }
        await RetryPreviewAsync();
    }
    private async Task RetryPreviewAsync()
    {
        if (previewTrack is not { } track || track.Origin.Protected) return;
        playingSequence = previewSequence.Where(t => !t.Origin.Protected).ToArray();
        followingPlayback = true;
        await Start(track, previewOfflineOnly);
    }
    private async Task StopPreviewAsync() { await DismissPreviewAsync(); await Stop(); }
    private async Task FavoriteAsync(Track track)
    {
        if (savingFavorite is not null) return;
        savingFavorite = track.Id;
        try { await OnFavorite.InvokeAsync(track); }
        finally { savingFavorite = null; }
    }
    public void UpdatePresentedTrack(Track track)
    {
        if (SameTrack(editingTrack, track)) editingTrack = track;
        if (SameTrack(previewTrack, track)) previewTrack = track;
        previewSequence = previewSequence.Select(t => SameTrack(t, track) ? track : t).ToArray();
    }
    protected override void OnInitialized() { Transfers.Changed += TransfersChanged; playingSequence = Playback.PlayingSequence; Playback.Changed += PlaybackChanged; }
    private void PlaybackChanged()
    {
        volume = Playback.OutputVolume;
        if (lifetime.IsCancellationRequested) return;
        _ = InvokeAsync(() =>
        {
            if (lifetime.IsCancellationRequested) return;
            playingSequence = Playback.PlayingSequence; playError = Playback.Error; playingOffline = current is not null && IsSaved(current);
            if (!SameTrack(audioTrack, current)) audio = null;
            if (followingPlayback)
            {
                if (current is null) ClosePreview();
                else { previewTrack = current; previewSequence = playingSequence; }
            }
            StateHasChanged();
        });
    }
    private void ReceiveAudioState(AudioState? state)
    {
        audio = state; audioTrack = current;
        if (state?.Error is { } error) playError = error;
    }
    private void ReceiveAudioError(Exception error) => playError = Td.SafeError(error);
    private void PlaybackStatusChanged() { if (!lifetime.IsCancellationRequested) StateHasChanged(); }
    private void TransfersChanged()
    {
        if (lifetime.IsCancellationRequested) return;
        _ = InvokeAsync(() =>
        {
            if (lifetime.IsCancellationRequested) return;
            if (lastTransfer is { } id && Transfers.Jobs.FirstOrDefault(j => j.Id == id) is { } job)
            {
                if (job.State == TransferState.Completed) feedback = job.Purpose == TransferPurpose.Offline ? $"Saved {job.Track.Title} offline. Play it here anytime, even after reopening the app." : job.Result;
                else if (job.State == TransferState.Canceled) feedback = job.Purpose == TransferPurpose.Offline ? "Offline save canceled." : "Download canceled.";
                else if (job.State == TransferState.Failed) { actionError = job.Error; feedback = null; }
                else if (job.State == TransferState.ReadyToExport) feedback = "Your file is ready. Open Downloads and choose Save file.";
            }
            StateHasChanged();
        });
    }
    private Guid? lastTransfer;

    private Task Search(LibrarySearchCriteria value) { selectedTracks.Clear(); feedback = null; return OnSearch.InvokeAsync(value); }
    private Task ClearAdvancedFiltersAsync(LibrarySearchCriteria value) { selectedTracks.Clear(); channel = ""; feedback = null; return OnClearFilters.InvokeAsync(value); }
    private async Task ResetFilters() { await ResetAsync(true); await ViewChanged.InvokeAsync(View is "offline" or "playlist" ? View : "all"); }
    public async Task ResetAsync(bool clearSearch, bool notify = true)
    {
        channel = ""; feedback = actionError = null;
        if (clearSearch) searchControls?.ResetDrafts(new());
        await DismissPreviewAsync();
        if (notify) await OnClearFilters.InvokeAsync(clearSearch ? new() : Criteria);
    }
    private async Task EditAsync(Track track) { await DismissPreviewAsync(); editingTrack = track; }
    private Task DownloadAsync(Track track) => Download(track);
    private Task ToggleOfflineAsync(Track track) => ToggleOffline(track, IsSaved(track));
    private async Task SelectChannelAsync(string value) { selectedTracks.Clear(); channel = value; await ChannelChanged(); }
    private Task ChannelChanged() => OnChannel.InvokeAsync(long.TryParse(channel, out var chat) ? chat : null);
    public async Task FilterSource(long chatId, bool notify = true) { channel = chatId.ToString(CultureInfo.InvariantCulture); if (notify) await ChannelChanged(); }
    private async Task Add(Track track)
    {
        if (savingList) return;
        savingList = true; feedback = actionError = null;
        var removing = playlistMembership.Contains(track.Id);
        try { await OnAdd.InvokeAsync(track); feedback = removing ? $"Removed {track.Title} from {Playlist.Name}." : $"Added {track.Title} to {Playlist.Name}."; }
        catch (Exception e) { actionError = Td.SafeError(e); }
        finally { savingList = false; }
    }
    private async Task Listen(Track track) { if (current?.Id == track.Id && Playback.CanResume && audio?.Error is null) await Toggle(); else await PlayCollectionAsync(track, View == "offline"); }
    private async Task Start(Track track, bool? offlineContext = null)
    {
        var offlineOnly = offlineContext ?? View == "offline";
        var mine = ++request; audio = null; playError = null;
        playingOffline = IsSaved(track);
        await InvokeAsync(StateHasChanged);
        try
        {
            if (IsCurrent(track) && Playback.CurrentEntryId is not null) await Playback.RetryAsync(lifetime.Token);
            else await PlayCollectionAsync(track, offlineOnly);
            if (mine == request && IsCurrent(track)) { audio = await Playback.StateAsync(lifetime.Token); audioTrack = track; }
        }
        catch (Exception e) { if (mine == request) playError = Td.SafeError(e); }
        finally { if (mine == request && !lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged); }
    }
    private async Task Toggle()
    {
        if (buffering) { await Stop(); return; }
        try { if (Playback.IsPlaying) await Playback.PauseAsync(); else { if (audio?.Ended == true) await Playback.SeekAsync(0); await Playback.ResumeAsync(lifetime.Token); } audio = await Playback.StateAsync(lifetime.Token); playError = null; }
        catch (Exception e) { playError = Td.SafeError(e); }
    }
    private async Task Stop() { ++request; try { await Playback.StopAsync(); audio = null; playError = null; playingSequence = []; } catch (Exception e) { playError = Td.SafeError(e); } }
    private Track? Adjacent(int delta) => Playback.Adjacent(delta);
    private async Task Skip(int delta) { try { await Playback.SkipAsync(delta, lifetime.Token); } catch (Exception e) { playError = Td.SafeError(e); } }
    private async Task SeekAsync(double value) { try { await Playback.SeekAsync(value); audio = await Playback.StateAsync(lifetime.Token); } catch (Exception e) { playError = Td.SafeError(e); } }
    private async Task SetVolumeAsync(double value) { try { await Playback.SetVolumeAsync(value); volume = value; } catch (Exception e) { playError = Td.SafeError(e); } }
    private Task Volume(ChangeEventArgs args) => double.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, out var value) ? SetVolumeAsync(value) : Task.CompletedTask;
    private async Task ToggleOffline(Track track, bool saved)
    {
        if (!saved) { await Download(track, offline: true); return; }
        actionError = feedback = null;
        try
        {
            if (current?.Id == track.Id) await Stop();
            await Host.RemoveOfflineAsync(track, lifetime.Token);
            playingSequence = playingSequence.Where(t => t.Id != track.Id).ToArray();
            await OnOfflineChanged.InvokeAsync();
            feedback = $"Removed {track.Title} from this device. It is still in your library.";
        }
        catch (Exception e) { actionError = Td.SafeError(e); }
    }
    private async Task Download(Track track, bool offline = false)
    {
        actionError = feedback = null;
        try
        {
            await Transfers.BindAsync(Session.AccountId, lifetime.Token);
            lastTransfer = (await Transfers.EnqueueAsync([track], offline ? TransferPurpose.Offline : TransferPurpose.Export, ct: lifetime.Token)).First();
            feedback = offline ? "Added to Downloads for offline saving." : "Added to Downloads. Choose Save file when ready.";
        }
        catch (Exception e) { actionError = Td.SafeError(e); }
    }
    private Task CancelDownload() => ActiveTransfer is { } job ? Transfers.CancelAsync(job.Id) : Task.CompletedTask;
    private async Task SavePlaylistOffline()
    {
        try
        {
            var tracks = ReadOfflinePlaylist is null ? Tracks : await ReadOfflinePlaylist();
            await Transfers.BindAsync(Session.AccountId, lifetime.Token);
            var ids = await Transfers.EnqueueAsync(tracks, TransferPurpose.Offline, Guid.NewGuid(), lifetime.Token);
            feedback = $"Added {ids.Length} songs to Downloads. Future playlist changes will not download automatically.";
        }
        catch (Exception e) { actionError = Td.SafeError(e); }
    }
    public async Task CancelWorkAsync() { searchControls?.ResetDrafts(new()); await DismissPreviewAsync(); Artwork.CancelAll(); if (editor is not null) await editor.CloseAsync(); await CancelDownload(); await Stop(); }
    public async Task CancelSourceAsync(Source source)
    {
        Artwork.RemoveSource(source);
        if (previewTrack?.Origin is { } preview && preview.AccountId == source.AccountId && preview.ChatId == source.ChatId) await DismissPreviewAsync();
        if (editingTrack?.Origin is { } editing && editing.AccountId == source.AccountId && editing.ChatId == source.ChatId && editor is not null) await editor.CloseAsync();
        if (downloadingTrack?.Origin is { } download && download.AccountId == source.AccountId && download.ChatId == source.ChatId) await CancelDownload();
        if (current?.Origin is { } playing && playing.AccountId == source.AccountId && playing.ChatId == source.ChatId) await Stop();
    }
    public async Task RemoveTracksAsync(IReadOnlyCollection<Guid> ids) { if (previewTrack is { } preview && ids.Contains(preview.Id)) await DismissPreviewAsync(); previewSequence = previewSequence.Where(t => !ids.Contains(t.Id)).ToArray(); if (editingTrack is { } editing && ids.Contains(editing.Id) && editor is not null) await editor.CloseAsync(); playingSequence = playingSequence.Where(t => !ids.Contains(t.Id)).ToArray(); if (downloadingTrack is { } downloading && ids.Contains(downloading.Id)) await CancelDownload(); if (current is { } track && ids.Contains(track.Id)) await Stop(); await Playback.RemoveTracksAsync(ids); }
    private static string Time(double seconds) { var span = TimeSpan.FromSeconds(Math.Max(0, double.IsFinite(seconds) ? seconds : 0)); return span.TotalHours >= 1 ? $"{(long)span.TotalHours}:{span:mm\\:ss}" : span.ToString(@"m\:ss"); }
    private static string Size(long bytes) => bytes >= 1048576 ? $"{bytes / 1048576d:0.#} MB" : $"{Math.Max(0, bytes) / 1024d:0.#} KB";
    private static string Format(MediaFile file) => Path.GetExtension(file.FileName).TrimStart('.').ToUpperInvariant() is { Length: > 0 } extension ? extension : "AUDIO";
    public async ValueTask DisposeAsync() { Playback.Changed -= PlaybackChanged; Transfers.Changed -= TransfersChanged; lifetime.Cancel(); await Task.CompletedTask; lifetime.Dispose(); }
