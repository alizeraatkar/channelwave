    }
    private Task LogOut() => Run(async () =>
    {
        if (!cleanupPending)
        {
            cleanupAccount = Session.AccountId; cleanupPending = true; HomeState.Bind(null); InvalidateLibraryLoad();
            logoutPrepared = logoutClosed = libraryCleared = sessionCleared = cleanupCheckpointSaved = remoteLogout = false;
            cleanupCheckpointPhase = null; cleanupRecovery = false;
        }
        status = null;
        string? checkpointError = null;
        async Task SaveCheckpointAsync(string phase)
        {
            if (cleanupAccount is not { } account) return;
            try
            {
                await Library.SaveStateAsync(0, CleanupKey, JsonSerializer.Serialize(new CleanupCheckpoint(account, remoteLogout, phase)));
                cleanupCheckpointSaved = true; cleanupCheckpointPhase = phase;
                checkpointError = null;
            }
            // A full or failing store must not prevent attempted sign-out and erasure.
            catch (Exception e) { checkpointError = Td.SafeError(e); }
        }
        // Record intent before preparation can pause, fail, or be interrupted by closing the app.
        if (!cleanupCheckpointSaved) await SaveCheckpointAsync(logoutClosed ? "closed" : "requested");
        if (!logoutPrepared)
        {
            await presentation.BindAsync(null); overview = null; profile = null;
            await Transfers.BindAsync(null);
            await transferRefresh;
            await MetadataScanner.SuspendAsync();
            if (music is not null) await music.CancelWorkAsync();
            // Signing out erases these checkpoints; storage exhaustion must not stop logout.
            await Sync.PauseAsync(preserveResume: true);
            await Catalog.PauseAsync(preserveResume: true);
            lifetime.Cancel(); await syncRefresh; await Playback.StopAsync(); await Playback.BindListeningAsync(null);
            logoutPrepared = true;
            tracks = []; offlineTracks = []; sources = []; input = ""; searchCriteria = new(); homeHasMusic = false; HomeState.Bind(null); browseAccount = null; browseGroups = []; groupCovers = []; browseMode = "tracks"; browseGroup = browseLabel = null;
            channelMessage = channelError = indexError = null; ResetPlaylists();
        }
        if (!logoutClosed)
        {
            if (Session.Authorization.State == "closed") logoutClosed = true;
            else if (cleanupRecovery)
            {
                // A prior cleanup may already have erased the session after its final marker write failed.
                if (Session.Authorization.State != "idle" || await Host.HasSavedSessionAsync()) remoteLogout = await Session.RecoverLogOutAsync(await Host.ConfigurationAsync());
                else remoteLogout = false;
                logoutClosed = true;
            }
            else { remoteLogout = await Session.LogOutAsync(); logoutClosed = true; }
        }
        // Independent cleanup stages can fail separately. Preserve the account and completed
        // stages so retry never depends on a live session or the canceled component token.
        var failures = new List<string>();
        if (cleanupCheckpointPhase != "closed") await SaveCheckpointAsync("closed");
        if (!libraryCleared)
        {
            try { if (cleanupAccount is { } id) { await Host.ClearOfflineAccountAsync(id, CancellationToken.None); await Library.ClearAccountAsync(id); } libraryCleared = true; }
            catch (Exception e) { failures.Add("Library cleanup: " + Td.SafeError(e)); }
        }
        if (!sessionCleared)
        {
            try { await Host.ClearSessionAsync(); sessionCleared = true; }
            catch (Exception e) { failures.Add("Session cleanup: " + Td.SafeError(e)); }
        }
        if (failures.Count > 0)
        {
            if (checkpointError is not null) failures.Add("Cleanup recovery could not be saved. Keep this app open until cleanup succeeds. " + checkpointError);
            throw new InvalidOperationException(string.Join(" ", failures));
        }
        if (cleanupCheckpointSaved) await Library.SaveStateAsync(0, CleanupKey, "null");
        cleanupPending = false; cleanupAccount = null;
        status = remoteLogout ? "Signed out remotely and erased local account data. Reopen ChannelWave to connect." : "Local account data erased. Remote logout was not confirmed. Revoke this session from Telegram Settings → Devices. Reopen ChannelWave to connect.";
    }, "Signing out and erasing local data…");
