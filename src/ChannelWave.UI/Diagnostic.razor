    private async Task Index(Source channel)
    {
        if (busy) return;
        busy = true; indexingChat = channel.ChatId; indexError = null; indexErrorChat = null; unindexMessage = unindexError = null;
        channelMessage = sources.Any(x => x.ChatId == channel.ChatId)
            ? $"Loading older audio from {channel.Name}…" : $"Adding audio from {channel.Name}…";
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        indexCancellation = cancellation;
        await InvokeAsync(StateHasChanged);
        try
        {
            var source = sources.FirstOrDefault(x => x.ChatId == channel.ChatId) ?? channel;
            await Sync.SelectAsync(source, cancellation.Token);
            await Refresh(); channelMessage = $"Audio indexing is queued for {channel.Name}.";
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { channelMessage = "Indexing canceled. Your previously saved audio is still in the library."; }
        catch (Exception e) { indexErrorChat = channel.ChatId; indexError = Td.SafeError(e); channelMessage = null; }
        finally { indexCancellation = null; indexingChat = null; busy = false; }
    }
    private async Task Unindex(Source channel)
    {
        if (busy) return;
        busy = true; unindexingChat = channel.ChatId; unindexError = null; indexError = null;
        unindexMessage = $"Unindexing {channel.Name}…";
        await InvokeAsync(StateHasChanged);
        try
        {
            await MetadataScanner.SuspendAsync();
            await Transfers.RemoveSourceAsync(channel.ChatId, lifetime.Token);
            if (music is not null) await music.CancelSourceAsync(channel);
            foreach (var copy in await Host.OfflineCopiesAsync(channel.AccountId, lifetime.Token))
                if (copy.Track.Origin.ChatId == channel.ChatId) await Host.RemoveOfflineAsync(copy.Track, lifetime.Token);
            var removed = await Sync.UnindexAsync(channel, lifetime.Token);
            await presentation.ReconcileSourceTabsAsync(channel.AccountId, await Library.SourcesAsync(channel.AccountId, lifetime.Token));
            if (music is not null) await music.RemoveTracksAsync(removed); else await Playback.RemoveTracksAsync(removed);
            HomeState.Invalidate(); await Refresh(); unindexMessage = $"Unindexed {channel.Name}. You can index it again whenever you like.";
        }
        catch (Exception e) { unindexError = Td.SafeError(e); unindexMessage = null; try { await Refresh(); } catch (Exception refreshError) { error = Td.SafeError(refreshError); } }
        finally { busy = false; unindexingChat = null; if (!disposed && !lifetime.IsCancellationRequested) await MetadataScanner.RestoreAsync(lifetime.Token); }
    }
    private void CancelIndex() => indexCancellation?.Cancel();
