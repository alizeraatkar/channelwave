    private Task Favorite(Track track) => Run(async () =>
    {
        await Library.SetFavoriteAsync(track.Origin.AccountId, track.Id, !track.Favorite, lifetime.Token);
        var updated = track with { Favorite = !track.Favorite };
        await Playback.UpdateTrackMetadataAsync(updated, lifetime.Token);
        music?.UpdatePresentedTrack(updated);
        HomeState.Invalidate(); await Refresh();
    });
