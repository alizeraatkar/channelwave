@using ChannelWave.Core
@using ChannelWave.Telegram
@using Bit.BlazorUI
@using System.Text.Json
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject TelegramSession Session
@inject ILibraryRepository Library
@inject IRuntimeHost Host
@inject PlaybackCoordinator Playback
@inject PlaybackMediaResolver PlaybackMedia
@inject ChannelSync Sync
@inject ChannelCatalog Catalog
@inject MetadataScanner MetadataScanner
@inject IJSRuntime JS
@inject TransferManager Transfers
@inject MediaStorageService Storage
@inject HomeSessionState HomeState

<link rel="stylesheet" href="_content/ChannelWave.UI/listening.css" />
<link rel="stylesheet" href="_content/ChannelWave.UI/discovery.css" />
<link rel="stylesheet" href="_content/ChannelWave.UI/redesign.css" />

@if (!initializationComplete)
{
    <StartupScreen />
}
else
{
<CascadingValue Value="presentation" IsFixed="true">
<CascadingValue Name="BrowseMusicCredit" Value="CreditNavigation" IsFixed="true">
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="app-shell redesign @(Route.IsRoot ? "root-page" : "detail-page")" data-update-busy="@(busy || connecting || cleanupPending || restoringCleanup || syncPending || catalogPending ? "true" : "false")">
    <header class="app-topbar">
        <div class="app-brand-status">
            <button class="brand" aria-label="ChannelWave home" @onclick='() => Navigate("home")'><span class="brand-mark"><img src="_content/ChannelWave.UI/brand/channelwave-mark.svg" alt="" /></span><strong>ChannelWave</strong></button>
            <TelegramActivityStatus Suppressed="@(cleanupPending || restoringCleanup)" />
        </div>
        <div class="app-topbar-actions">
            <button class="downloads-shortcut" aria-label="Open Downloads" @onclick='() => Navigate("downloads")'><MusicIcon Name="download" /><span>@Transfers.Jobs.Count(j => !j.Finished)</span></button>
            @if (page == "home" && HomeAccount is not null)
            {
                <button id="edit-home-tabs" class="icon-button" aria-label="Edit Home tabs" @onclick='() => Navigate("customize")'><MusicIcon Name="more" /></button>
            }
        </div>
    </header>
    <aside class="app-sidebar" aria-label="Your library sidebar">
        <RootNavigation Active="Route.Root" OnNavigate="Navigate" />
        <ConnectionStatus />
    </aside>
    <main id="main-content" class="content" tabindex="-1">
        @if (!Route.IsRoot)
        {
            <div class="detail-toolbar">
                <button class="subtle-button" aria-label="Go back" @onclick="Back"><MusicIcon Name="back" />Back</button><span>@Route.Root / @PageTitle</span>
                @if (Route.Root == RootSection.Library && page != "search")
                { <button class="icon-button detail-search" aria-label="Open search" @onclick='() => Navigate("search")'><MusicIcon Name="search" /></button> }
            </div>
        }
        @if (customizationError is not null) { <p class="music-error" role="alert">@customizationError</p> }
        @if (page == "playlist" && selectedPlaylist is { } selected && !AllPlaylists.Any(p => p.Id == selected))
        { <p role="status">This playlist is no longer available. Your other music is unchanged. <button class="subtle-button" @onclick='() => Navigate("library")'>Open Library</button></p> }
        @if (page == "library")
        {
            <LibraryLanding Overview="overview" PlaylistCount="AllPlaylists.Count" OfflineCount="offlineCopies.Count(c => c.Health == OfflineHealth.Saved)" SourceCount="sources.Count" OnNavigate="OpenCategory" OnFilter="OpenSavedFilter" />
        }
        @if (page == "customize") { <HomeTabEditor Playlists="AllPlaylists" OnDone="Back" /> }
        @if (page == "playlists") { <PlaylistCatalog Playlists="AllPlaylists" Display="Display" OnDisplay="ChangeDisplay" OnSelect="SelectPlaylist" OnEdit="EditPlaylist" Busy="busy" /> }
        @if (page == "about") { <section class="account-page"><h1>About ChannelWave</h1><p>Your sources. Your music.</p><p>A personal music library for Telegram, stored on this device.</p><p class="muted">@Host.Capabilities.Host &middot; TDLib @Session.Version</p></section> }
        @if (error is not null || Session.Error is not null) { <p class="error" role="alert">@(error ?? Session.Error)</p> }
        @if (!cleanupVerified && !restoringCleanup) { <button class="outline-button" disabled="@busy" @onclick="VerifyCleanup">Retry local cleanup check</button> }
        <PlaybackPersistenceNotice />
        @if (status is not null) { <p class="status" role="status">@status</p> }
        @if (page == "home")
        {
            @if (HomeAccount is { } homeAccount)
            {
                <MusicHome @key="homeAccount" Account="homeAccount" Revision="homeRevision" TabId="@homeTab" InitialLimit="restoredItemLimit" Playlists="AllPlaylists" Busy="busy" OnTab="SelectHomeTab" OnPreview="PreviewHome" OnAction="HomeAction" OnOpen="OpenItem" />
            }
            @if (!homeHasMusic)
            {
            <section class="home-feature">
                <div class="feature-copy"><h1>Your sources.<br />Your kind of music.</h1><p>All the tracks you find on Telegram.<br />One place to make them yours.</p>
                    @if (Session.AccountId is null) { <button class="primary-button" disabled="@(busy || connecting || Session.Authorization.State != "idle")" @onclick="Connect">@if (connecting) { <LoadingIndicator Decorative="true" /> }@(connecting ? "Reconnecting…" : "Connect account")<MusicIcon Name="arrow" /></button> }
                    else { <button class="primary-button" @onclick='() => Navigate(sources.Count == 0 ? "channels" : "tracks")'>@(sources.Count == 0 ? "Choose your sources" : "Explore your music")<MusicIcon Name="arrow" /></button> }
                </div>
                <div class="feature-record" aria-hidden="true"><div class="record-disc"><span><img class="brand-art" src="_content/ChannelWave.UI/brand/channelwave-mark.svg" alt="" width="48" height="48" /></span></div><div class="record-sleeve"><img class="brand-art" src="_content/ChannelWave.UI/brand/channelwave-mark.svg" alt="" width="32" height="32" /><strong>YOUR<br />OWN<br />WAVE.</strong><span>CHANNELWAVE</span></div></div>
            </section>
            }
        }
        @if (page is "account" or "settings")
        {
            <section class="account-page" aria-label="Connection">
                <div class="account-symbol"><MusicIcon Name="@(Session.AccountId is null ? "source" : "check")" /></div>
                <h1>@(page == "settings" ? "Settings" : Session.AccountId is null ? "Connect Telegram" : "Profile")</h1>
                @if (page == "account" && (Session.Identity ?? profile) is not null)
                { <div class="profile-identity"><span class="profile-avatar">@ProfileInitials</span><div><h2 dir="auto">@ProfileName</h2>@if (ProfileUsername is not null) { <p dir="auto">@@@ProfileUsername</p> }</div></div> }
                <p class="account-intro">@(Session.AccountId is null ? "Connect Telegram, choose the sources you love, and give their music a home." : "Manage your Telegram connection and the library stored on this device.")</p>
                @if (busyLabel is not null || Session.IsResolvingAccount) { <p><LoadingIndicator Label='@(Session.IsResolvingAccount ? "Loading your Telegram account…" : busyLabel!)' /></p> }
                @if (page == "account")
                {
                <div class="connection-form" aria-busy="@(busy || connecting || Session.IsResolvingAccount ? "true" : "false")">
                    @if (cleanupPending)
                    {
                        @if (!busy) { <p role="status">Sign-out cleanup is incomplete. Retry before reconnecting.</p> }
                        <button class="primary-button" disabled="@busy" @onclick="LogOut">Retry sign-out cleanup</button>
                    }
                    else if (Session.Authorization.State == "ready" && Session.AccountId is null)
                    {
                        @if (!Session.IsResolvingAccount) { <p role="status">Your Telegram account could not be loaded.</p> }
                        <button class="primary-button" disabled="@(busy || Session.IsResolvingAccount)" @onclick="RetryAccount">Retry account connection</button>
                    }
                    else if (Session.Authorization.State is "phone" or "code" or "password" or "email" or "emailCode")
                    {
                        <form @onsubmit="Submit" @onsubmit:preventDefault><label for="auth-value">@Session.Authorization.Label</label>
                            @if (Session.Authorization.Delivery is not null) { <p class="muted">Delivery reported by Telegram: @Session.Authorization.Delivery</p> }
                            <input id="auth-value" type="@(Session.Authorization.State == "password" ? "password" : Session.Authorization.State == "phone" ? "tel" : Session.Authorization.State == "email" ? "email" : "text")" @bind="input" autocomplete="off" required />
                            <button class="primary-button" type="submit" disabled="@busy">@if (busy) { <LoadingIndicator Decorative="true" /> }@(busy ? "Connecting…" : "Continue")</button>
                        </form>
                    }
                    else if (Session.AccountId is null)
                    {
                        <button class="primary-button" disabled="@(busy || connecting || Session.Authorization.State != "idle")" @onclick="Connect">@if (connecting || busy) { <LoadingIndicator Decorative="true" /> }@(connecting ? "Reconnecting…" : busy ? "Connecting…" : "Connect account")</button>
                        @if (Session.Authorization.State != "idle" && busyLabel is null) { <p role="status">@if (connecting) { <LoadingIndicator Decorative="true" /> }@Session.Authorization.Label</p> }
                    }
                    else { <p class="connection-confirmed"><MusicIcon Name="check" />Connected to Telegram</p><button class="outline-button" disabled="@busy" @onclick="LogOut">Sign out and erase local data</button> }
                </div>
                <p class="privacy-note"><MusicIcon Name="shield" /><span>ChannelWave is an independent Telegram client. Connecting creates a Telegram session with access beyond the music sources you select. Your session stays on this device or browser profile.</span></p>
                <button class="settings-row" @onclick='() => Navigate("settings")'><MusicIcon Name="shield" />Listening &amp; privacy<MusicIcon Name="arrow" /></button>
                <button class="settings-row" @onclick='() => Navigate("about")'><MusicIcon Name="info" />About ChannelWave<MusicIcon Name="arrow" /></button>
                }
                @if (page == "settings")
                {
                    <button class="settings-row" @onclick='() => Navigate("downloads")'><MusicIcon Name="download" />Offline downloads<MusicIcon Name="arrow" /></button>
                    <section class="account-details"><h2>Storage</h2><p>Manage saved songs and temporary files on this device.</p><button class="outline-button" @onclick='() => Navigate("storage")'>Manage storage</button></section>
                    <section class="account-details" aria-label="Automatic metadata">
                        <h2>Music details</h2>
                        <p role="status">@(MetadataScanner.Enabled ? MetadataScanner.Progress.Phase == "reading" ? "Loading music details..." : "Automatic loading enabled" : "Automatic loading paused")  /  @MetadataScanner.Progress.Completed processed  /  @MetadataScanner.Progress.Failed failed attempts</p>
                        @if (MetadataScanner.Progress.Error is { } metadataError) { <p class="music-error">@metadataError</p> }
                        <button class="outline-button" disabled="@busy" @onclick="ToggleMetadata">@(MetadataScanner.Enabled ? "Pause metadata loading" : "Resume metadata loading")</button>
                        <button class="outline-button" disabled="@busy" @onclick="RetryMetadata">Retry failed metadata</button>
                    </section>
                }
                @if (page == "settings" && cleanupVerified && !cleanupPending && Playback.ListeningAccount is not null) { <ListeningSettings /> }
                @if (page == "settings") { <div class="settings-row"><MusicIcon Name="appearance" /><span>Appearance</span><span>Dark</span></div> }
                @if (page == "account") { <details class="account-details"><summary>Connection details</summary><p class="muted">@Host.Capabilities.Host · @Session.Authorization.State</p><button class="outline-button" disabled="@busy" @onclick="Probe">Check Telegram engine</button>@if (Session.Version is not null) { <p class="muted">Engine @Session.Version</p> }<p class="muted">@(Host.Capabilities.BackgroundAudio ? "Music keeps playing when you leave the app. Use the notification or lock-screen controls to manage playback." : "This build supports foreground listening. Use Offline for songs saved on this device.") Release validation remains pending.</p></details> }
            </section>
        }
        @if (page == "activity")
        {
            @if (cleanupVerified && !cleanupPending && Playback.ListeningAccount is { } listeningAccount)
            {
                <ListeningActivityPage @key="listeningAccount" Account="listeningAccount" OnPrivacy='() => Navigate("settings")' OnSource="OpenHistorySource" />
            }
            else { <section class="listening-page"><h1>@PageTitle</h1><p>@(connecting ? "Restoring your account…" : "Connect your account to view listening saved on this device.")</p><ListeningIconButton Icon="user" Label="Connect Telegram account" OnClick='() => Navigate("account")' /></section> }
        }
        @if (page == "downloads") { <DownloadsPage OnStorage='() => Navigate("storage")' /> }
        @if (page == "storage" && (Session.AccountId ?? offlineTracks.FirstOrDefault()?.Origin.AccountId) is { } storageAccount)
        {
            <StoragePage Account="storageAccount" OnBack="Back" OnOffline='() => Navigate("offline")' />
        }
        @if (page == "storage" && Session.AccountId is null && offlineTracks.Count == 0) { <section class="media-page"><h1>Storage</h1><p>Connect your account to manage its local storage.</p><button class="primary-button" @onclick='() => Navigate("account")'>Connect Telegram</button></section> }
        @if (Session.AccountId is not null)
        {
            <div hidden='@(page != "channels")' class="channels-page">
                <div class="screen-heading"><h1>Your sources</h1><p>Choose the sources. We'll bring the music.</p></div>
                @if (sources.Count > 0) { <ChannelSyncPanel Progress="@Sync.Progress" Running="@Sync.IsRunning" Pending="@syncPending" Disabled="@busy" Error="@syncError" OnStart="StartSync" OnPause="PauseSync" /> }
                @if (sources.Count == 0) {<ChannelCatalogPanel Progress="@Catalog.Progress" Running="@Catalog.IsRunning" Pending="@catalogPending" Error="@catalogError" OnStart="LoadChannels" OnPause="PauseDiscovery" /> }
                <ChannelPicker Channels="@Catalog.Channels" Sources="@sources" IsBusy="@(busy || syncPending)" IsLoading="@(Catalog.IsRunning || catalogPending)" IsIndexing="@Sync.IsRunning" IndexingChatId="@indexingChat" UnindexingChatId="@unindexingChat" ErrorChatId="@indexErrorChat" Message="@(unindexMessage ?? channelMessage)" UnindexError="@unindexError" OnUnindex="Unindex" OnRefresh="RefreshSource" LoadError="@channelError" IndexError="@indexError" OnLoad="LoadChannels" OnIndex="Index" OnCancel="CancelIndex" />
                @if (sources.Count > 0) {<ChannelCatalogPanel Progress="@Catalog.Progress" Running="@Catalog.IsRunning" Pending="@catalogPending" Error="@catalogError" OnStart="LoadChannels" OnPause="PauseDiscovery" /> }

            </div>
        }
        @if (Session.AccountId is not null || Host.CanSaveOffline || Playback.CurrentTrack is not null)
        {
            <MusicLibrary @ref="music" SelectedSource="selectedChannel" HomeVisible='@(page == "home" && cleanupVerified && !cleanupPending)' ShowTransferSummary='@(page != "downloads")' OfflineCopies="@offlineCopies" OnDownloads='() => Navigate("downloads")' OnActivity='() => Navigate("activity")' OfflineTracks="@offlineTracks" OnOfflineChanged="OfflineChanged" OnMetadataChanged="MetadataChanged" Tracks="@(HasCurrentResults ? tracks : [])" LoadState="@libraryLoadState" LoadError="@libraryLoadError" LoadMoreFailed="retryLoadMore" OnRetry="() => LoadLibraryAsync(more: retryLoadMore)" Sources="@ViewSources" Playlist='@(libraryView == "playlist" ? ActivePlaylist : playlist)' Playlists="@AllPlaylists" OnPlaylistEdit="EditPlaylist" OnPlaylistSelect="SelectPlaylist" PlaylistSort="@playlistSort" OnPlaylistSort="SortPlaylist" ReadPlaylist="ReadPlaylistTracks" ReadOfflinePlaylist="ReadOfflinePlaylistSnapshot" ReadQueue="ReadQueueTrackIdsAsync" Busy="@busy" CanLoadMore="@(HasCurrentResults && canLoadMore)" Criteria="searchCriteria" OnSearch="SearchMusic" OnClearFilters="ClearSearchFilters" OnChannel="FilterChannel" OnLoadMore="LoadMoreMusic" OnFavorite="Favorite" OnAdd="TogglePlaylist" ShowContent='@(cleanupVerified && !cleanupPending && page is "tracks" or "search" or "favorites" or "playlist" or "offline")' View="@libraryView" ViewChanged="ChangeLibraryView" SearchMode='@(page == "search")' OnChannels='() => Navigate("channels")' BrowseSummary='@(GroupListing ? $"{browseGroups.Length} {browseMode} shown" : null)' BrowseResults='@(page == "search" && browseMode == "playlists" ? PlaylistResults : GroupListing ? GroupResults : null)' Display="Display" OnDisplay="ChangeDisplay" OnSaveFilter="() => saveFilterOpen = true" OnPinCollection="PinCurrentCollection" CanPinCollection="@(browseGroup is not null || page == "playlist")" BrowseContext="@DiscoveryContext" CollectionLabel='@(page is "tracks" or "offline" ? browseLabel : null)'>
                <BrowseTools>
                    @if (page == "search")
                    { <div class="discovery-tabs" role="group" aria-label="Search result types">@foreach (var kind in new[] { "tracks", "artists", "albums", "playlists" }) { <button aria-pressed="@((browseMode == kind).ToString().ToLowerInvariant())" @onclick="() => SearchKind(kind)">@System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(kind)</button> }</div> }
                    @if (libraryView != "playlist") { <DiscoveryToolbar Mode="@browseMode" Group='@(page is "tracks" or "offline" ? browseGroup : null)' ShowModes="false" Order="generalOrder" Disabled="@(busy || libraryLoadState is LibraryLoadState.Refreshing or LibraryLoadState.LoadingMore || tracks.Count == 0)" OnMode="ChangeBrowseMode" OnSort="ChangeGeneralOrder" OnPlay="PlayBrowse" /> }
                </BrowseTools>

            </MusicLibrary>
        }
        <LibraryDialog Open="saveFilterOpen" Title="Save filter" OnClose="() => saveFilterOpen = false">
            <form @onsubmit="SaveFilter" @onsubmit:preventDefault><label for="saved-filter-name">Filter name</label><input id="saved-filter-name" @bind="filterName" maxlength="100" required /><button class="primary-button">Save filter</button></form>
            @if (customizationError is not null) { <p role="alert">@customizationError</p> }
        </LibraryDialog>
        <footer class="app-footer"><span>ChannelWave</span><span>Your sources. Your music.</span><button class="subtle-button" @onclick='() => Navigate("account")'>Connection &amp; privacy</button></footer>
    </main>
    @if (Route.IsRoot) { <RootNavigation Mobile="true" Active="Route.Root" OnNavigate="Navigate" /> }
    <div class="idle-player" aria-label="Player"><div class="mini-cover"><MusicIcon /></div><div><strong>Choose a song to start listening</strong></div><button class="icon-button" disabled aria-label="Play a song from your library"><MusicIcon Name="play" /></button></div>
</div>
</CascadingValue>
</CascadingValue>
}
@code {
    private async Task RestoreListeningAsync(long account)
    {
        await presentation.BindAsync(account, lifetime.Token);
        if (disposed || cleanupPending || presentation.Account != account) return;
        await Playback.BindListeningAsync(account, (id, ct) => PlaybackMedia.ResolveAsync(account, id, ct),
            (track, ct) => PlaybackMedia.PrepareAsync(track, Playback.OfflineOnly, ct), lifetime.Token);
        if (!disposed && !cleanupPending && Session.AccountId == account) await presentation.RememberAccountAsync(account, lifetime.Token);
    }
    private async Task OpenHistorySource(long chat)
    {
        var source = sources.FirstOrDefault(x => x.ChatId == chat);
        if (source is null) { error = "This source is no longer in your library."; return; }
        await OpenSource(source);
    }
    private string page = "home", libraryView = "all";
    private bool focusPage, initializationComplete, navigationStarted, startupStarted, startupSessionChecked;
    private long navigationVersion;
    private IJSObjectReference? navigation;
    private DotNetObjectReference<Diagnostic>? navigationReference;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!initializationComplete) return;
        if (!navigationStarted)
        {
            navigationStarted = true;
            var initialNavigation = navigationVersion;
            navigation = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChannelWave.UI/navigation.js");
            await navigation.InvokeVoidAsync("watchLayout");
            navigationReference = DotNetObjectReference.Create(this);
            await navigation.InvokeVoidAsync("watchActivity", navigationReference);
            var initialPage = await navigation.InvokeAsync<string>("watchNavigation", navigationReference, page);
            if (!cleanupPending && initialNavigation == navigationVersion && initialPage != page)
            {
                await Navigate(initialPage);
                if (page == "home") homeTab = HomeState.SelectedTab;
                StateHasChanged();
            }
            if (page == "home" && Session.Authorization.State is "phone" or "code" or "password" or "email" or "emailCode")
            {
                page = "account"; focusPage = true; StateHasChanged();
            }
        }
        if (!startupStarted && cleanupVerified && !cleanupPending)
        {
            startupStarted = true;
            startupConnection = RestoreStartupAsync();
        }
        if (navigation is not null) await navigation.InvokeVoidAsync("recordPage", CurrentRoute);
        if (focusHomeTab && navigation is not null)
        {
            focusHomeTab = false;
            await navigation.InvokeVoidAsync("focusHomeTab", homeTab);
        }
        if (!focusPage) return;
        focusPage = false;
        navigation ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChannelWave.UI/navigation.js");
        await navigation.InvokeVoidAsync("focusPage");
    }
    private long? HomeAccount => cleanupVerified && !cleanupPending ? Session.AccountId ?? Playback.ListeningAccount : null;
    private string PageTitle => page switch { "library" => "Library", "settings" => "Settings", "playlists" => "Playlists", "customize" => "Edit tabs", "about" => "About ChannelWave", "offline" => "Offline", "downloads" => "Downloads", "storage" => "Storage", "activity" => "Listening activity", "home" => "Home", "search" => "Search", "tracks" => "Your Library", "favorites" => "Liked Songs", "playlist" => ActivePlaylist.Name, "channels" => "Your sources", _ => "Account" };
    [JSInvokable]
    public async Task SetActivityAsync(bool active)
    {
        if (disposed || cleanupPending || Session.AccountId is null) return;
        try
        {
            if (active) await Sync.RestoreAsync(lifetime.Token);
            else await Sync.PauseAsync(preserveResume: true);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception e) { syncError = Td.SafeError(e); }
    }
    [JSInvokable]
    public async Task RestorePageAsync(string destination)
    {
        if (disposed || destination.Split('~')[0] is not ("home" or "library" or "settings" or "customize" or "playlists" or "about" or "profile" or "search" or "tracks" or "favorites" or "playlist" or "offline" or "channels" or "account" or "downloads" or "storage" or "activity" or "history" or "statistics")) return;
        if (!destination.Contains('~') && destination is "tracks" or "search" or "favorites" or "offline")
            ApplyBrowseState(new("tracks", null, null, LibraryOrder.AddedNewest, new(), null));
        await Navigate(destination);
        StateHasChanged();
    }
    private async Task Navigate(string destination)
    {
        if (navigation is not null) { await navigation.InvokeVoidAsync("captureHomeScroll"); await navigation.InvokeVoidAsync("capturePage"); }
        navigationVersion++;
        var route = destination.Split('~', 2); destination = route[0] == "profile" ? "account" : route[0] == "library" && route.Length == 2 ? "tracks" : route[0];
        if (destination is "history" or "statistics") destination = "activity";
        if (route.Length == 2)
        {
            try { if (JsonSerializer.Deserialize<BrowsePreferences>(Uri.UnescapeDataString(route[1])) is { } state) { ApplyBrowseState(state); routeHasBrowse = true; } }
            catch (Exception e) when (e is JsonException or ArgumentException) { browseMode = "tracks"; browseGroup = browseLabel = null; }
        }
        if (destination == "tracks" && Session.AccountId is null && startupSessionChecked && !connecting && Session.Authorization.State == "idle" && Host.CanSaveOffline) destination = "offline";
        page = destination;
        focusPage = true;
        libraryView = destination switch { "favorites" => "favorites", "playlist" => "playlist", "offline" => "offline", _ => "all" };
        if (route.Length == 1)
        {
            selectedChannel = null; searchCriteria = new(); savedFilterId = null;
            if (destination == "home") homeTab = HomeState.SelectedTab;
            if (destination is "tracks" or "search" or "favorites" or "offline")
            { browseMode = "tracks"; browseGroup = browseLabel = null; generalOrder = LibraryOrder.AddedNewest; }
        }
        restoredItemLimit = navigation is null ? 100 : await navigation.InvokeAsync<int>("restoredLoaded");
        loadedLimit = restoredItemLimit;
        if (music is not null) await music.ResetAsync(clearSearch: route.Length == 1 && destination != "search", notify: false);
        if (music is not null && selectedChannel is { } restoredSource) await music.FilterSource(restoredSource, notify: false);
        if (destination is "tracks" or "search" or "favorites" or "playlist" or "offline" || overview is null || destination == "library" && presentationDirty || presentation.Account != (Session.AccountId ?? Playback.ListeningAccount)) await LoadLibraryAsync();
    }
    private async Task ChangeLibraryView(string value) { navigationVersion++; if (value == "all") { browseMode = "tracks"; browseGroup = browseLabel = null; if (generalOrder == LibraryOrder.Album) generalOrder = LibraryOrder.AddedNewest; } libraryView = value; page = value switch { "favorites" => "favorites", "playlist" => "playlist", "offline" => "offline", _ => "tracks" }; loadedLimit = 100; focusPage = true; await LoadLibraryAsync(); }
    private async Task OpenSource(Source source)
    {
        // Select the destination and source before the first refresh. Publishing
        // an intermediate unfiltered library races background refreshes and focus.
        navigationVersion++; page = "tracks"; libraryView = "all"; focusPage = true; browseMode = "tracks"; browseGroup = browseLabel = null;
        searchCriteria = new(); selectedChannel = source.ChatId; loadedLimit = 100;
        if (music is not null)
        {
            await music.ResetAsync(clearSearch: true, notify: false);
            await music.FilterSource(source.ChatId, notify: false);
        }
        await LoadLibraryAsync();
    }
    private Task FilterChannel(long? chat) { selectedChannel = chat; loadedLimit = 100; return LoadLibraryAsync(); }
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "#" : System.Globalization.StringInfo.GetNextTextElement(name.Trim());
    private bool busy; private string? error, status; private string input = "";
    private LibrarySearchCriteria searchCriteria = new();
    private bool connecting;
    private LibraryLoadState libraryLoadState;
    private string? libraryLoadError;
    private long libraryLoadVersion;
    private long? libraryLoadAccount;
    private bool libraryRefreshPending;
